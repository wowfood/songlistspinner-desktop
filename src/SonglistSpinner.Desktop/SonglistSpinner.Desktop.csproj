<Project Sdk="Microsoft.NET.Sdk.Razor">
    <PropertyGroup>
        <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
        <OutputType>WinExe</OutputType>
        <RootNamespace>SonglistSpinner</RootNamespace>
        <UseMaui>true</UseMaui>
        <SingleProject>true</SingleProject>
        <EnableDefaultCssItems>false</EnableDefaultCssItems>
        <MauiVersion>10.0.90</MauiVersion>
        <IncludeAllContentForSelfExtract>true</IncludeAllContentForSelfExtract>
        <!-- Display name -->
        <ApplicationTitle>SonglistSpinner</ApplicationTitle>
        <!-- App Identifier -->
        <ApplicationId>com.wowfood.songlistspinner.desktop</ApplicationId>
        <!-- Versions -->
        <VersionPrefix>1.2.0</VersionPrefix>
        <Version>$(VersionPrefix)</Version>
        <ApplicationDisplayVersion>$(VersionPrefix)</ApplicationDisplayVersion>
        <ApplicationVersion>4</ApplicationVersion>
        <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
        <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
        <WindowsPackageType>None</WindowsPackageType>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)' == 'Release'">
        <WindowsPackageType>None</WindowsPackageType>
        <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
        <GenerateAppxPackageOnBuild>false</GenerateAppxPackageOnBuild>
        <EnableMsixTooling>true</EnableMsixTooling>
        <DebugType>none</DebugType>
        <DebugSymbols>false</DebugSymbols>
        <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
    </PropertyGroup>

    <!--
      The test-profile variables (SONGLISTSPINNER_PROFILE_DIR, SONGLISTSPINNER_WEBVIEW_ARGS) are compiled in for
      Debug builds and for builds that ask for them (scripts/run-e2e.ps1 passes -p:EnableTestProfile=true). A
      Release build, and so every published executable, ignores both; TestProfileBuild.cs says why. The assembly
      metadata is how the end-to-end tests tell that a built app honours them before they start it.
    -->
    <PropertyGroup>
        <EnableTestProfile Condition="'$(EnableTestProfile)' == '' And '$(Configuration)' == 'Debug'">true</EnableTestProfile>
        <DefineConstants Condition="'$(EnableTestProfile)' == 'true'">$(DefineConstants);TEST_PROFILE</DefineConstants>
    </PropertyGroup>
    <ItemGroup Condition="'$(EnableTestProfile)' == 'true'">
        <AssemblyMetadata Include="SonglistSpinner.TestProfile" Value="enabled"/>
    </ItemGroup>
    <!--
      MSBuild also takes EnableTestProfile from an environment variable of that name, so a publish refuses to go
      ahead with it on however it was set. scripts/publish-single-file.ps1 passes -p:EnableTestProfile=false,
      which overrides the environment.
    -->
    <Target Name="RefuseToPublishWithTheTestProfile"
            BeforeTargets="PrepareForPublish"
            Condition="'$(EnableTestProfile)' == 'true'">
        <Error Text="EnableTestProfile is true, so this build honours the test-profile variables and must not be published. Publish with -p:EnableTestProfile=false."/>
    </Target>
    <!--
      The check above reads the property of this publish, not what an earlier build compiled in, and a publish
      that skips the build would package whatever is already there (scripts/run-e2e.ps1 leaves a test-profile
      build in the same folder). So a publish always builds.
    -->
    <Target Name="RefuseToPublishWithoutBuilding"
            BeforeTargets="PrepareForPublish"
            Condition="'$(NoBuild)' == 'true'">
        <Error Text="Publishing without building is not supported: the existing build may honour the test-profile variables. Publish without --no-build."/>
    </Target>

    <!-- RID-specific settings apply only when the publish command supplies win-x64. -->
    <PropertyGroup Condition="'$(Configuration)' == 'Release' And '$(RuntimeIdentifier)' == 'win-x64'">
        <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
        <SelfContained>true</SelfContained>
        <PublishSingleFile>true</PublishSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <!-- App Icon -->
        <MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\songlistspinnerfg.svg" Color="#512BD4"/>
        <!-- Splash Screen -->
        <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#512BD4" BaseSize="128,128"/>
        <!-- Custom Fonts -->
        <MauiFont Include="Resources\Fonts\*"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="$(MauiVersion)"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.11"/>
        <PackageReference Include="MudBlazor" Version="9.3.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SonglistSpinner.Application\SonglistSpinner.Application.csproj"/>
        <ProjectReference Include="..\SonglistSpinner.Core\SonglistSpinner.Core.csproj"/>
    </ItemGroup>
    <!-- The overlay's wwwroot files are embedded in SonglistSpinner.Application, beside LocalOverlayServer. -->

    <!--
      .NET 10 adds both the build and publish static-web-asset endpoint manifests
      to the bundle with the same relative path. Keep the publish manifest and
      discard only its redundant build-time counterpart.
    -->
    <Target Name="ExcludeBuildStaticWebAssetEndpointsManifestFromBundle"
            AfterTargets="PrepareForBundle"
            Condition="'$(PublishSingleFile)' == 'true'">
        <ItemGroup>
            <FilesToBundle Remove="@(FilesToBundle)"
                           Condition="'%(FilesToBundle.Filename)%(FilesToBundle.Extension)' == 'staticwebassets.build.endpoints.json'"/>
        </ItemGroup>
    </Target>
</Project>
