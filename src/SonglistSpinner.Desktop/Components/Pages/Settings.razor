@page "/settings"
@inject ILocalSettingsService LocalSettings
@inject IStreamerSongListCredentialStore CredentialStore
@inject ISpinnerApiService ApiService
@inject SonglistSpinner.Core.Api.V2.StreamerSongListApiOptions ApiOptions
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject OverlayStateService OverlayService
@inject ApplicationUpdateService UpdateService
@inject IJSRuntime JS
@implements IDisposable

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmNavigationAsync"/>

<main class="ss-main ss-settings-shell">
    <header class="ss-settings-heading">
        <div>
            <span class="ss-settings-eyebrow">Configuration</span>
            <h1>Settings</h1>
            <p>Configure the spinner by task and see overlay changes before you save them.</p>
        </div>
        @if (_dto is not null)
        {
            <span class="ss-settings-draft-state @(HasUnsavedChanges ? "changed" : "saved")">
                @(HasUnsavedChanges ? "Unsaved draft" : "All changes saved")
            </span>
        }
    </header>

    @if (_dto is null || _editContext is null)
    {
        <div class="ss-settings-loading">Loading settings...</div>
    }
    else
    {
        <EditForm EditContext="_editContext" OnValidSubmit="Save">
            <div class="ss-settings-workspace">
                <nav class="ss-settings-nav" aria-label="Settings sections">
                    <button type="button" class="@SectionClass(SettingsSection.Connection)"
                            aria-pressed="@(_activeSection == SettingsSection.Connection)"
                            @onclick="@(() => SelectSection(SettingsSection.Connection))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#128268;</span>
                        <span><strong>Connection</strong><small>Channel and API access</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Spinner)"
                            aria-pressed="@(_activeSection == SettingsSection.Spinner)"
                            @onclick="@(() => SelectSection(SettingsSection.Spinner))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#8635;</span>
                        <span><strong>Spinner &amp; Queue</strong><small>Winner and history rules</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Overlay)"
                            aria-pressed="@(_activeSection == SettingsSection.Overlay)"
                            @onclick="@(() => SelectSection(SettingsSection.Overlay))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#9638;</span>
                        <span><strong>Overlay Layout</strong><small>Played and Now Playing</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Appearance)"
                            aria-pressed="@(_activeSection == SettingsSection.Appearance)"
                            @onclick="@(() => SelectSection(SettingsSection.Appearance))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#9680;</span>
                        <span><strong>Appearance</strong><small>Colors and wheel style</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Advanced)"
                            aria-pressed="@(_activeSection == SettingsSection.Advanced)"
                            @onclick="@(() => SelectSection(SettingsSection.Advanced))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#9881;</span>
                        <span><strong>Advanced</strong><small>Diagnostics and endpoints</small></span>
                    </button>
                </nav>

                <div class="ss-settings-editor">
                    @switch (_activeSection)
                    {
                        case SettingsSection.Connection:
                            <div class="ss-settings-section-heading">
                                <span>Connection</span>
                                <h2>Choose the channel this installation controls</h2>
                                <p>The channel identity and secure credential are kept separate from overlay appearance.</p>
                            </div>

                            <section class="ss-settings-section">
                                <h3>Queue Source</h3>
                                <div class="ss-field">
                                    <label for="defaultStreamerName">Default StreamerSongList Name</label>
                                    <InputText id="defaultStreamerName" @bind-Value="_dto.DefaultStreamerName"
                                               placeholder="e.g. wowfood"/>
                                    <div class="ss-field-hint">Automatically loads this channel when the Dashboard opens.</div>
                                </div>
                                <div class="ss-field">
                                    <label for="streamerPlatform">Platform Identity</label>
                                    <InputSelect id="streamerPlatform" @bind-Value="_dto.StreamerPlatform">
                                        <option value="twitch">Twitch</option>
                                        <option value="youtube">YouTube</option>
                                        <option value="kick">Kick</option>
                                        <option value="none">StreamerSongList</option>
                                    </InputSelect>
                                    <div class="ss-field-hint">Selects the public route used to resolve the StreamerSongList channel.</div>
                                </div>
                                <div class="ss-field">
                                    <label class="ss-checkbox-label">
                                        <InputCheckbox @bind-Value="_dto.HideChangeOptionWhenDefault"/>
                                        Hide “Change Streamer” when the default channel is set
                                    </label>
                                </div>
                            </section>

                            <section class="ss-settings-section">
                                <h3>StreamerSongList API v2 Access</h3>
                                <div class="ss-field">
                                    <label for="credentialKind">Credential Type</label>
                                    <InputSelect id="credentialKind" @bind-Value="_credentialKind">
                                        <option value="@StreamerSongListCredentialKind.Streamer">Streamer token</option>
                                        <option value="@StreamerSongListCredentialKind.User">User token</option>
                                        <option value="@StreamerSongListCredentialKind.OAuthBearer">OAuth bearer token</option>
                                    </InputSelect>
                                    <div class="ss-field-hint">For one channel, use a streamer token created under StreamerSongList Settings &gt; Access.</div>
                                </div>
                                <div class="ss-field">
                                    <label for="apiToken">API Token</label>
                                    <InputText id="apiToken" @bind-Value="_credentialToken" type="password"
                                               autocomplete="off" placeholder="Leave blank to keep the saved token"/>
                                    <div class="ss-field-hint">Stored in Windows secure storage and never written to the repository.</div>
                                </div>
                                @if (_credentialKind == StreamerSongListCredentialKind.OAuthBearer)
                                {
                                    <div class="ss-field">
                                        <label for="oauthClientId">OAuth Client ID</label>
                                        <InputText id="oauthClientId" @bind-Value="_credentialClientId" autocomplete="off"/>
                                    </div>
                                }
                                <div class="ss-credential-row">
                                    @if (_hasCredential)
                                    {
                                        <span class="ss-auth-status ss-auth-ok">&#10003; API credential configured</span>
                                        <button type="button" class="ss-btn-danger-subtle" @onclick="ClearApiCredential">Clear</button>
                                    }
                                    else
                                    {
                                        <span class="ss-auth-status ss-auth-none">No API credential configured</span>
                                    }
                                </div>
                                <div class="ss-settings-actions">
                                    <button type="button" class="ss-btn-primary" @onclick="TestApiConnection"
                                            disabled="@_testingCredential">
                                        @(_testingCredential ? "Testing..." : "Save and test connection")
                                    </button>
                                    <button type="button" class="ss-btn-secondary" @onclick="OpenSetupWizard">
                                        Open connection wizard
                                    </button>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_credentialTestResult))
                                {
                                    <div class="@(_credentialTestSucceeded ? "ss-save-success ss-settings-result" : "ss-save-error ss-settings-result")"
                                         role="status">
                                        @_credentialTestResult
                                    </div>
                                }
                            </section>
                            break;

                        case SettingsSection.Spinner:
                            <div class="ss-settings-section-heading">
                                <span>Spinner &amp; Queue</span>
                                <h2>Control what can be selected and what happens next</h2>
                                <p>These options change queue filtering and the explicit actions offered after a spin.</p>
                            </div>

                            <section class="ss-settings-section">
                                <h3>Winner Actions</h3>
                                <div class="ss-field">
                                    <label class="ss-checkbox-label">
                                        <InputCheckbox @bind-Value="_dto.UpdateQueueAfterSpin"
                                                       disabled="@_dto.DisplayNowPlaying"/>
                                        Prefer Mark Played in the winner popup
                                    </label>
                                    <div class="ss-field-hint">Highlights Mark Played as the suggested action. No queue change occurs until an action is chosen.</div>
                                </div>
                                <div class="ss-field">
                                    <label class="ss-checkbox-label">
                                        <InputCheckbox @bind-Value="_dto.DisplayNowPlaying"/>
                                        Enable Now Playing workflow
                                    </label>
                                    <div class="ss-field-hint">Adds Set Now Playing to the winner popup and enables the configurable overlay panel.</div>
                                </div>
                            </section>

                            <section class="ss-settings-section">
                                <h3>Queue Filtering &amp; History</h3>
                                <div class="ss-field">
                                    <label class="ss-checkbox-label">
                                        <InputCheckbox @bind-Value="_dto.ExcludePlayedSongs"/>
                                        Exclude already-played songs from the wheel
                                    </label>
                                </div>
                                <div class="ss-field">
                                    <label for="playHistoryPeriod">Play History Period</label>
                                    <InputSelect id="playHistoryPeriod" @bind-Value="_dto.PlayHistoryPeriod">
                                        <option value="stream">Recent (API v2)</option>
                                        <option value="day">Last 24 hours</option>
                                        <option value="week">Last 7 days</option>
                                        <option value="month">Last month</option>
                                        <option value="all">All time</option>
                                    </InputSelect>
                                    <div class="ss-field-hint">This range supplies the played panel and, when enabled, the wheel exclusion filter.</div>
                                </div>
                            </section>
                            break;

                        case SettingsSection.Overlay:
                            <div class="ss-settings-section-heading">
                                <span>Overlay Layout</span>
                                <h2>Arrange the information your viewers see</h2>
                                <p>Use the preview to check field order, panel location, typography, and Now Playing placement.</p>
                            </div>

                            <section class="ss-settings-section">
                                <h3>Played Songs Panel</h3>
                                <div class="ss-field">
                                    <label>Display Fields</label>
                                    <div class="ss-field-multiselect">
                                        @for (var i = 0; i < _vm.DisplayFields.Count; i++)
                                        {
                                            var idx = i;
                                            var field = _vm.DisplayFields[i];
                                            <div class="ss-chip @(field.Selected ? "ss-chip-selected" : "ss-chip-unselected") @(_vm.DragOverIdx == idx && _vm.DragIdx != idx ? "ss-chip-drag-over" : "")"
                                                 draggable="true"
                                                 @ondragstart="@(() => BeginPlayedFieldDrag(idx))"
                                                 @ondragover="@(_ => SetPlayedFieldDragOver(idx))"
                                                 @ondragover:preventDefault
                                                 @ondrop="@(() => DropPlayedField(idx))"
                                                 @ondragend="@(_ => EndPlayedFieldDrag())"
                                                 @onclick="@(() => TogglePlayedField(idx))">
                                                <span class="ss-chip-handle" aria-hidden="true">&#10247;</span>
                                                @FieldLabel(field.Name)
                                            </div>
                                        }
                                    </div>
                                    <div class="ss-field-hint">Click to include or exclude a field. Drag selected fields into display order.</div>
                                </div>
                                <div class="ss-settings-field-grid">
                                    <div class="ss-field">
                                        <label for="playedListPosition">Panel Position</label>
                                        <InputSelect id="playedListPosition" @bind-Value="_dto.PlayedListPosition">
                                            <option value="right">Right</option>
                                            <option value="left">Left</option>
                                        </InputSelect>
                                    </div>
                                    <div class="ss-field">
                                        <label for="playedListFont">Font Family</label>
                                        <InputSelect id="playedListFont" @bind-Value="_dto.PlayedListFontFamily">
                                            @foreach (var font in FontChoices)
                                            {
                                                <option value="@font.Value">@font.Label</option>
                                            }
                                        </InputSelect>
                                    </div>
                                    <div class="ss-field">
                                        <label for="playedListFontSize">Font Size</label>
                                        <InputText id="playedListFontSize" @bind-Value="_dto.PlayedListFontSize" placeholder="0.875rem"/>
                                    </div>
                                    <div class="ss-field">
                                        <label for="playedListMaxLines">Maximum Lines per Song</label>
                                        <InputNumber id="playedListMaxLines" @bind-Value="_dto.PlayedListMaxLines" min="1" max="5"/>
                                    </div>
                                </div>
                            </section>

                            <section class="ss-settings-section @(!_dto.DisplayNowPlaying ? "ss-settings-section-muted" : "")">
                                <div class="ss-settings-section-title-row">
                                    <h3>Now Playing Panel</h3>
                                    <span>@(_dto.DisplayNowPlaying ? "Enabled" : "Disabled")</span>
                                </div>
                                @if (!_dto.DisplayNowPlaying)
                                {
                                    <p class="ss-settings-inline-notice">
                                        Enable the Now Playing workflow under Spinner &amp; Queue to show and configure this panel.
                                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Spinner))">Open winner settings</button>
                                    </p>
                                }
                                else
                                {
                                    <div class="ss-field">
                                        <label>Display Fields</label>
                                        <div class="ss-field-multiselect">
                                            @for (var i = 0; i < _vm.NowPlayingDisplayFields.Count; i++)
                                            {
                                                var idx = i;
                                                var field = _vm.NowPlayingDisplayFields[i];
                                                <div class="ss-chip @(field.Selected ? "ss-chip-selected" : "ss-chip-unselected") @(_vm.NowPlayingDragOverIdx == idx && _vm.NowPlayingDragIdx != idx ? "ss-chip-drag-over" : "")"
                                                     draggable="true"
                                                     @ondragstart="@(() => BeginNowPlayingFieldDrag(idx))"
                                                     @ondragover="@(_ => SetNowPlayingFieldDragOver(idx))"
                                                     @ondragover:preventDefault
                                                     @ondrop="@(() => DropNowPlayingField(idx))"
                                                     @ondragend="@(_ => EndNowPlayingFieldDrag())"
                                                     @onclick="@(() => ToggleNowPlayingField(idx))">
                                                    <span class="ss-chip-handle" aria-hidden="true">&#10247;</span>
                                                    @FieldLabel(field.Name)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    <div class="ss-settings-field-grid">
                                        <div class="ss-field">
                                            <label for="nowPlayingPosition">Screen Position</label>
                                            <InputSelect id="nowPlayingPosition" @bind-Value="_dto.NowPlayingPosition">
                                                <option value="top-left">Top left</option>
                                                <option value="top-center">Top center</option>
                                                <option value="top-right">Top right</option>
                                                <option value="bottom-left">Bottom left</option>
                                                <option value="bottom-center">Bottom center</option>
                                                <option value="bottom-right">Bottom right</option>
                                            </InputSelect>
                                        </div>
                                        <div class="ss-field">
                                            <label for="nowPlayingWidth">Panel Width</label>
                                            <InputText id="nowPlayingWidth" @bind-Value="_dto.NowPlayingWidth" placeholder="28rem"/>
                                            <div class="ss-field-hint">CSS sizes such as 28rem, 480px, or 40vw.</div>
                                        </div>
                                        <div class="ss-field">
                                            <label for="nowPlayingFont">Font Family</label>
                                            <InputSelect id="nowPlayingFont" @bind-Value="_dto.NowPlayingFontFamily">
                                                @foreach (var font in FontChoices)
                                                {
                                                    <option value="@font.Value">@font.Label</option>
                                                }
                                            </InputSelect>
                                        </div>
                                        <div class="ss-field">
                                            <label for="nowPlayingFontSize">Font Size</label>
                                            <InputText id="nowPlayingFontSize" @bind-Value="_dto.NowPlayingFontSize" placeholder="1.125rem"/>
                                        </div>
                                    </div>
                                }
                            </section>
                            break;

                        case SettingsSection.Appearance:
                            <div class="ss-settings-section-heading">
                                <span>Appearance</span>
                                <h2>Build a readable overlay that fits your stream</h2>
                                <p>Color and wheel changes are reflected in the preview without altering the live OBS source.</p>
                            </div>

                            <section class="ss-settings-section">
                                <h3>Background</h3>
                                <div class="ss-settings-field-grid">
                                    <div class="ss-field">
                                        <label for="backgroundMode">Mode</label>
                                        <InputSelect id="backgroundMode" @bind-Value="_dto.BackgroundMode">
                                            <option value="color">Solid color</option>
                                            <option value="transparent">Transparent</option>
                                        </InputSelect>
                                        <div class="ss-field-hint">Transparent mode is intended for an OBS browser source.</div>
                                    </div>
                                    <div class="ss-field ss-field-row">
                                        <label>Background Color</label>
                                        <div class="ss-color-preview" style="background:@_dto.BackgroundColor">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" ShowAlpha="false"
                                                            @bind-Value="ColorBackground"/>
                                        </div>
                                    </div>
                                </div>
                            </section>

                            <section class="ss-settings-section">
                                <h3>Wheel Palette</h3>
                                <div class="ss-field">
                                    <label for="wheelColors">Wheel Colors</label>
                                    <InputTextArea id="wheelColors" @bind-Value="WheelColorsRaw" rows="6"/>
                                    <div class="ss-field-hint">Enter one CSS color per line. The wheel repeats the palette when necessary.</div>
                                </div>
                            </section>

                            <section class="ss-settings-section">
                                <h3>Overlay Colors</h3>
                                <div class="ss-color-grid">
                                    <div class="ss-field ss-field-row">
                                        <label>Text</label>
                                        <div class="ss-color-preview" style="background:@_dto.ColorText">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" ShowAlpha="false" @bind-Value="ColorText"/>
                                        </div>
                                    </div>
                                    <div class="ss-field ss-field-row">
                                        <label>Pointer</label>
                                        <div class="ss-color-preview" style="background:@_dto.ColorPointer">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" ShowAlpha="false" @bind-Value="ColorPointer"/>
                                        </div>
                                    </div>
                                    <div class="ss-field ss-field-row">
                                        <label>Button Background</label>
                                        <div class="ss-color-preview" style="background:@_dto.ColorButtonBackground">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" ShowAlpha="false" @bind-Value="ColorButtonBg"/>
                                        </div>
                                    </div>
                                    <div class="ss-field ss-field-row">
                                        <label>Button Text</label>
                                        <div class="ss-color-preview" style="background:@_dto.ColorButtonText">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" ShowAlpha="false" @bind-Value="ColorButtonText"/>
                                        </div>
                                    </div>
                                    <div class="ss-field ss-field-row">
                                        <label>Played Panel Background</label>
                                        <div class="ss-color-preview" style="background:@_vm.ComputedPlayedListBg()">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" @bind-Value="ColorPlayedListBg"/>
                                        </div>
                                    </div>
                                    <div class="ss-field ss-field-row">
                                        <label>Played Song Background</label>
                                        <div class="ss-color-preview" style="background:@_dto.ColorPlayedItemBackground">
                                            <MudColorPicker PickerVariant="PickerVariant.Inline" ShowAlpha="false" @bind-Value="ColorPlayedItemBg"/>
                                        </div>
                                    </div>
                                </div>
                            </section>
                            break;

                        case SettingsSection.Advanced:
                            <div class="ss-settings-section-heading">
                                <span>Advanced</span>
                                <h2>Diagnostics and implementation details</h2>
                                <p>Most installations should not need to change these options.</p>
                            </div>

                            <section class="ss-settings-section">
                                <h3>Diagnostics</h3>
                                <div class="ss-field">
                                    <label class="ss-checkbox-label">
                                        <InputCheckbox @bind-Value="_dto.DebugMode"/>
                                        Enable diagnostic output
                                    </label>
                                    <div class="ss-field-hint">
                                        Writes a rolling diagnostic log under <code>%LOCALAPPDATA%\SonglistSpinner\logs</code>.
                                        Streamer access tokens are not logged.
                                    </div>
                                    <div class="ss-settings-inline-actions">
                                        <button type="button" class="ss-btn-secondary" @onclick="OpenDiagnosticLogFolder">
                                            Open log folder
                                        </button>
                                    </div>
                                </div>
                            </section>

                            <section class="ss-settings-section">
                                <h3>Service Endpoints</h3>
                                <dl class="ss-settings-endpoints">
                                    <div><dt>Application</dt><dd><code>SonglistSpinner @UpdateService.CurrentVersion</code></dd></div>
                                    <div><dt>API</dt><dd><code>@ApiOptions.BaseAddress</code></dd></div>
                                    <div><dt>Local overlay</dt><dd><code>@OverlayService.OverlayUrl</code></dd></div>
                                    <div>
                                        <dt>Updates</dt>
                                        <dd>
                                            <a href="https://github.com/wowfood/songlistspinner-desktop/releases"
                                               target="_blank" rel="noopener noreferrer">Open GitHub Releases</a>
                                        </dd>
                                    </div>
                                </dl>
                                <div class="ss-field-hint">Endpoints are configured at application startup and are shown here for troubleshooting.</div>
                            </section>
                            break;
                    }
                </div>

                <aside class="ss-overlay-preview-panel" aria-label="Live overlay preview">
                    <div class="ss-overlay-preview-heading">
                        <div>
                            <span>Live Preview</span>
                            <strong>OBS overlay</strong>
                        </div>
                        <span class="ss-overlay-preview-badge">Unsaved draft</span>
                    </div>
                    <div class="ss-overlay-preview-stage">
                        <iframe id="settingsOverlayPreview" class="ss-overlay-preview-frame"
                                src="@PreviewUrl" title="Overlay settings preview"
                                sandbox="allow-scripts allow-same-origin"
                                @onload="OnPreviewLoadedAsync"></iframe>
                    </div>
                    <p class="ss-overlay-preview-help">
                        Sample songs keep the preview predictable. Changes stay here until you save; the live OBS source is not modified.
                    </p>
                    <div class="ss-overlay-preview-shortcuts" aria-label="Preview editing shortcuts">
                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Spinner))">Edit behavior</button>
                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Overlay))">Edit panels</button>
                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Appearance))">Edit colors</button>
                    </div>
                </aside>
            </div>

            <div class="ss-save-bar">
                <button type="submit">Save Settings</button>
                <span class="ss-save-bar-state">
                    @if (_vm.SaveSuccess)
                    {
                        <span class="ss-save-success">&#10003; Saved</span>
                    }
                    else if (_vm.SaveError is not null)
                    {
                        <span class="ss-save-error">&#10007; @_vm.SaveError</span>
                    }
                    else if (HasUnsavedChanges)
                    {
                        <span>Changes are previewed but not yet saved.</span>
                    }
                </span>
            </div>
        </EditForm>
    }
</main>
