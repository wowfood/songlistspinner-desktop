@page "/settings"
@inject PreferencesSettingsService LocalSettings
@inject IStreamerSongListCredentialStore CredentialStore
@inject ApiCredentialTest CredentialTest
@inject IStreamerSongListClient SongListClient
@inject SonglistSpinner.Core.StreamerSongList.Api.V2.StreamerSongListApiOptions ApiOptions
@inject IDialogService DialogService
@inject NavigationManager Navigation
@inject LocalOverlayServer OverlayServer
@inject StreamerSessionService StreamerSession
@inject IJSRuntime JS
@inject TimeProvider TimeProvider
@inject DiagnosticFileLoggerProvider DiagnosticLog
@inject ILogger<Settings> Logger
@implements IDisposable

<NavigationLock ConfirmExternalNavigation="@HasUnsavedChanges"
                OnBeforeInternalNavigation="ConfirmNavigationAsync"/>

<main class="ss-main ss-settings-shell">
    <header class="ss-settings-heading">
        <div>
            <span class="ss-settings-eyebrow">Configuration</span>
            <h1>Settings</h1>
            <p>Configure the spinner by task and see overlay changes before you save them.</p>
        </div>
        @if (_dto is not null)
        {
            <span class="ss-settings-draft-state @(HasUnsavedChanges ? "changed" : "saved")">
                @(HasUnsavedChanges ? "Unsaved draft" : "All changes saved")
            </span>
        }
    </header>

    @if (_dto is null || _editContext is null)
    {
        <div class="ss-settings-loading" role="status" aria-live="polite">Loading settings...</div>
    }
    else
    {
        <EditForm EditContext="_editContext" OnValidSubmit="Save">
            <div class="ss-settings-workspace">
                <nav class="ss-settings-nav" aria-label="Settings sections">
                    <button type="button" class="@SectionClass(SettingsSection.Connection)"
                            aria-pressed="@(_activeSection == SettingsSection.Connection ? "true" : "false")"
                            @onclick="@(() => SelectSection(SettingsSection.Connection))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#128268;</span>
                        <span><strong>Connection</strong><small>Channel and API access</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Spinner)"
                            aria-pressed="@(_activeSection == SettingsSection.Spinner ? "true" : "false")"
                            @onclick="@(() => SelectSection(SettingsSection.Spinner))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#8635;</span>
                        <span><strong>Spinner &amp; Queue</strong><small>Winner and history rules</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Overlay)"
                            aria-pressed="@(_activeSection == SettingsSection.Overlay ? "true" : "false")"
                            @onclick="@(() => SelectSection(SettingsSection.Overlay))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#9638;</span>
                        <span><strong>Overlay Layout</strong><small>Panels and winner dialog</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Appearance)"
                            aria-pressed="@(_activeSection == SettingsSection.Appearance ? "true" : "false")"
                            @onclick="@(() => SelectSection(SettingsSection.Appearance))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#9680;</span>
                        <span><strong>Appearance</strong><small>Colors and wheel style</small></span>
                    </button>
                    <button type="button" class="@SectionClass(SettingsSection.Advanced)"
                            aria-pressed="@(_activeSection == SettingsSection.Advanced ? "true" : "false")"
                            @onclick="@(() => SelectSection(SettingsSection.Advanced))">
                        <span class="ss-settings-nav-icon" aria-hidden="true">&#9881;</span>
                        <span><strong>Advanced</strong><small>Diagnostics and endpoints</small></span>
                    </button>
                </nav>

                <div class="ss-settings-editor">
                    @switch (_activeSection)
                    {
                        case SettingsSection.Connection:
                            <SettingsConnectionSection Dto="_dto"
                                                       @bind-CredentialKind="_credentialKind"
                                                       @bind-CredentialToken="_credentialToken"
                                                       @bind-CredentialClientId="_credentialClientId"
                                                       HasCredential="_hasCredential"
                                                       ClearingCredential="_clearingCredential"
                                                       TestingCredential="_testingCredential"
                                                       CredentialTestResult="@_credentialTestResult"
                                                       CredentialTestSucceeded="_credentialTestSucceeded"
                                                       ClearCredential="ClearApiCredentialAsync"
                                                       TestConnection="TestApiConnection"/>
                            break;

                        case SettingsSection.Spinner:
                            <SettingsSpinnerSection Dto="_dto"/>
                            break;

                        case SettingsSection.Overlay:
                            <SettingsOverlaySection Dto="_dto"
                                                    ViewModel="_vm"
                                                    CssValidation="_cssValidation"
                                                    CssValidationCleared="ClearCssValidation"
                                                    ResetDialogOpen="_resetDialogOpen"
                                                    ResetRequested="ReviewSettingsResetAsync"
                                                    @bind-PlayedListSeparatorChoice="PlayedListSeparatorChoice"
                                                    @bind-NowPlayingSeparatorChoice="NowPlayingSeparatorChoice"
                                                    OpenWinnerSettings="@(() => SelectSection(SettingsSection.Spinner))"
                                                    DraftChanged="QueuePreviewRefresh"/>
                            break;

                        case SettingsSection.Appearance:
                            <SettingsAppearanceSection Dto="_dto"
                                                       ViewModel="_vm"
                                                       CssValidation="_cssValidation"
                                                       CssValidationCleared="ClearCssValidation"
                                                       ResetDialogOpen="_resetDialogOpen"
                                                       ResetRequested="ReviewSettingsResetAsync"
                                                       DraftChanged="QueuePreviewRefresh"/>
                            break;

                        case SettingsSection.Advanced:
                            <SettingsAdvancedSection Dto="_dto"
                                                     ResetDialogOpen="_resetDialogOpen"
                                                     ResetRequested="ReviewSettingsResetAsync"
                                                     OpenLogFolder="OpenDiagnosticLogFolder"/>
                            break;
                    }
                </div>

                <aside class="ss-overlay-preview-panel" aria-label="Live overlay preview">
                    <div class="ss-overlay-preview-heading">
                        <div>
                            <span>Live Preview</span>
                            <strong>OBS overlay</strong>
                        </div>
                        <span class="ss-overlay-preview-badge">Unsaved draft</span>
                    </div>
                    <div class="ss-overlay-preview-stage">
                        <iframe id="settingsOverlayPreview" class="ss-overlay-preview-frame"
                                src="@PreviewUrl" title="Overlay settings preview"
                                sandbox="allow-scripts allow-same-origin"
                                @onload="OnPreviewLoadedAsync"></iframe>
                    </div>
                    <p class="ss-overlay-preview-help">
                        Sample songs keep the preview predictable. Changes stay here until you save; the live OBS source is not modified.
                    </p>
                    <div class="ss-overlay-preview-shortcuts" aria-label="Preview editing shortcuts">
                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Spinner))">Edit behavior</button>
                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Overlay))">Edit panels</button>
                        <button type="button" @onclick="@(() => SelectSection(SettingsSection.Appearance))">Edit colors</button>
                    </div>
                </aside>
            </div>

            <div class="ss-save-bar">
                <button type="submit">Save Settings</button>
                <span class="ss-save-bar-state" role="status" aria-live="polite" aria-atomic="true">
                    @if (_vm.SaveSuccess)
                    {
                        <span class="ss-save-success">&#10003; Saved</span>
                    }
                    else if (_vm.SaveError is not null)
                    {
                        <span class="ss-save-error">&#10007; @_vm.SaveError</span>
                    }
                    else if (HasUnsavedChanges)
                    {
                        <span>Changes are previewed but not yet saved.</span>
                    }
                </span>
            </div>
        </EditForm>
    }
</main>
