@page "/"
@page "/dashboard"
@layout MainLayout
@inject ISpinnerApiService ApiService
@inject IStreamerSongListCredentialStore CredentialStore
@inject ILocalSettingsService LocalSettings
@inject NowPlayingTransitionService NowPlayingTransitions
@inject IJSRuntime JS
@inject OverlayStateService OverlayService
@inject StreamerSessionService StreamerSession
@inject SonglistSpinner.Core.Api.V2.StreamerSongListApiOptions ApiOptions
@inject NavigationManager Navigation
@implements IAsyncDisposable

<h1 class="ss-visually-hidden">SonglistSpinner Dashboard</h1>

<section class="dashboard-health" aria-label="Service health">
    <div class="dashboard-health-item @ServiceHealthClass(_apiHealth)" title="@_apiHealthDetail"
         tabindex="0" aria-label="API: @ServiceHealthLabel(_apiHealth). @_apiHealthDetail">
        <span class="dashboard-health-dot" aria-hidden="true"></span>
        <span>API</span>
        <strong>@ServiceHealthLabel(_apiHealth)</strong>
    </div>
    <div class="dashboard-health-item @ServiceHealthClass(_realtimeHealth)" title="@_realtimeHealthDetail"
         tabindex="0" aria-label="Realtime: @ServiceHealthLabel(_realtimeHealth). @_realtimeHealthDetail">
        <span class="dashboard-health-dot" aria-hidden="true"></span>
        <span>Realtime</span>
        <strong>@ServiceHealthLabel(_realtimeHealth)</strong>
    </div>
    <div class="dashboard-health-item @OverlayHealthClass" title="@OverlayHealthDetail"
         tabindex="0" aria-label="Overlay: @OverlayHealthLabel. @OverlayHealthDetail">
        <span class="dashboard-health-dot" aria-hidden="true"></span>
        <span>Overlay</span>
        <strong>@OverlayHealthLabel</strong>
    </div>
    <div class="dashboard-health-item dashboard-health-channel"
         title="The StreamerSongList channel currently loaded" tabindex="0"
         aria-label="Channel: @(string.IsNullOrWhiteSpace(_currentStreamer) ? "Not loaded" : _currentStreamer)">
        <span>Channel</span>
        <strong>@(string.IsNullOrWhiteSpace(_currentStreamer) ? "Not loaded" : _currentStreamer)</strong>
    </div>
    <div class="dashboard-health-environment @ApiEnvironmentClass" title="@ApiOptions.BaseAddress"
         tabindex="0" aria-label="API environment: @ApiEnvironmentLabel. @ApiOptions.BaseAddress">
        @ApiEnvironmentLabel
    </div>
</section>

<div id="container">
    @if (_loading)
    {
        <div class="dashboard-loadingSection" role="status" aria-live="polite">
            <MudProgressCircular Color="Color.Default" Size="Size.Large" Indeterminate="true"/>
            <span class="ss-visually-hidden">Loading the Dashboard.</span>
        </div>
    }
    else
    {
        <div id="wheelSection">
            <div id="wheelContents">
                <div id="pointer"></div>
                <div id="wheelContainer"></div>
                <div id="buttonContainer">
                    <button id="spinButton" @onclick="Spin" disabled="@IsSpinDisabled">@_spinButtonText</button>
                </div>
                <div id="status" role="status" aria-live="polite" aria-atomic="true"
                     style="@(_statusVisible ? "display:block" : "display:none")">@_status</div>
            </div>
        </div>

        <div id="resizeHandle"
             role="separator"
             aria-label="Resize played songs panel"
             aria-controls="playedList"
             aria-orientation="vertical"
             aria-valuemin="300"
             aria-valuemax="800"
             tabindex="0"></div>

        <div id="playedList" data-position="@_config.SongList.PlayedListPosition">
            <div id="playedListTop">
                <button id="collapseBtn" class="collapse-button" @onclick="ToggleCollapse"
                        aria-controls="playedListContent"
                        aria-expanded="@(!_playedListCollapsed)"
                        aria-label="@(_playedListCollapsed ? "Expand played songs" : "Collapse played songs")">
                    <span id="collapseIcon" aria-hidden="true"></span>
                </button>
                <div id="streamerSection">
                    @if (_showStreamerInput)
                    {
                        <input type="text" id="streamerInput"
                               class="@(_streamerInputError is null ? null : "streamer-input-invalid")"
                               aria-invalid="@(_streamerInputError is null ? "false" : "true")"
                               aria-describedby="@(_streamerInputError is null ? null : "streamerInputError")"
                               @bind="StreamerInput"
                               @bind:event="oninput"
                               placeholder="Enter streamer name..."
                               @onkeydown="OnStreamerKeyDown"/>
                        <button class="small-button" @onclick="LoadStreamer">Load</button>
                    }
                    else
                    {
                        <span id="streamerLabel">Streamer: @_currentStreamer</span>
                        @if (!_isLockedDefault)
                        {
                            <button id="changeStreamerBtn" class="small-button" @onclick="ChangeStreamer">Change
                            </button>
                        }
                    }
                    <button id="refreshSongsBtn" class="small-button" @onclick="LoadStreamer">Refresh</button>
                    @if (_showStreamerInput && _streamerInputError is not null)
                    {
                        <div id="streamerInputError" class="streamer-input-error-message" role="alert">
                            <span aria-hidden="true">&#9888;</span>
                            <span>@_streamerInputError</span>
                        </div>
                    }
                </div>
            </div>
            <div id="playedListContent">
                @if (_nowPlaying is not null)
                {
                    <section id="nowPlayingControl" aria-label="Now Playing controls">
                        <div class="now-playing-summary">
                            <span class="now-playing-label">Now Playing</span>
                            <strong id="nowPlayingSong">@NowPlayingDisplayText</strong>
                        </div>
                        <button id="markNowPlayingPlayedBtn"
                                disabled="@(_markNowPlayingPending || _isSpinning)"
                                aria-describedby="nowPlayingSong"
                                @onclick="MarkNowPlayingPlayedAsync">
                            @(_markNowPlayingPending ? "Marking..." : "Mark Played")
                        </button>
                    </section>
                }
                <div id="songCounterSection">
                    <h3>Played Songs: <span id="playedCount">@_playedSongs.Length</span></h3>
                    <h3>Queued Songs: <span id="availableCount">@_availableSongs.Count</span></h3>
                </div>
                @if (!string.IsNullOrWhiteSpace(_currentStreamer) && _availableSongs.Count == 0)
                {
                    <p class="queue-empty-state" role="status">No eligible queued songs are available to spin.</p>
                }
                @{
                    var playedFieldTable = SpinnerDataService.CreatePlayedSongFieldTable(_playedSongs, _config);
                    var showPlayedFieldHeaders = _config.PlayedList.ShowFieldHeaders &&
                                                 playedFieldTable.Headers.Length > 0;
                }
                <ul id="playedSongsUl">
                    @if (_playedSongs.Length == 0)
                    {
                        <li class="played-list-empty-state">No played songs in the selected history period.</li>
                    }
                    else if (showPlayedFieldHeaders)
                    {
                        <li class="played-field-grid played-field-header-row"
                            aria-label="Played Songs field headers">
                            @if (_config.PlayedList.ShowNumbers)
                            {
                                <span class="played-song-number">#</span>
                            }
                            @for (var index = 0; index < playedFieldTable.Headers.Length; index++)
                            {
                                @if (index > 0)
                                {
                                    <span class="played-field-separator" aria-hidden="true"
                                          title="@playedFieldTable.Separator">@playedFieldTable.Separator</span>
                                }
                                <span class="played-field-header" title="@playedFieldTable.Headers[index]">
                                    @playedFieldTable.Headers[index]
                                </span>
                            }
                        </li>
                        @foreach (var row in playedFieldTable.Rows)
                        {
                            <li class="played-field-grid">
                                @if (row.Number is int number)
                                {
                                    <span class="played-song-number">@($"{number}.")</span>
                                }
                                @for (var index = 0; index < row.Values.Length; index++)
                                {
                                    @if (index > 0)
                                    {
                                        <span class="played-field-separator" aria-hidden="true"
                                              title="@playedFieldTable.Separator">@playedFieldTable.Separator</span>
                                    }
                                    <span class="played-song-cell" title="@row.Values[index]">@row.Values[index]</span>
                                }
                            </li>
                        }
                    }
                    else
                    {
                        @foreach (var text in SpinnerDataService.CreatePlayedSongTexts(_playedSongs, _config))
                        {
                            <li>
                                <span class="played-song-text">
                                    @text
                                </span>
                            </li>
                        }
                    }
                </ul>
            </div>
            <div class="toggle-container">
                @if (!_wheelVisible)
                {
                    <button id="playedListSpinButton"
                            class="small-button played-list-spin-button"
                            disabled="@IsSpinDisabled"
                            @onclick="Spin">
                        @_spinButtonText
                    </button>
                }
                <div class="toggle-right">
                    <span id="toggleWheelLabel" class="toggle-label">Show wheel</span>
                    <label class="switch">
                        <input type="checkbox" id="showWheelCheckbox" checked="@_wheelVisible"
                               aria-labelledby="toggleWheelLabel"
                               @onchange="OnWheelToggle"/>
                        <span class="slider round"></span>
                    </label>
                </div>
            </div>
        </div>
    }
</div>

<dialog id="winnerModal" class="winner-modal" aria-labelledby="winnerTitle" aria-describedby="winnerActionPrompt">
    <div class="winner-modal-content" aria-busy="@_winnerActionPending">
        <div id="winnerConfetti" class="winner-confetti" aria-hidden="true"></div>
        <h2 id="winnerTitle">Winner</h2>
        @if (_winnerFields.Length > 0)
        {
            <p id="winnerFields" class="winner-fields">
                @for (var i = 0; i < _winnerFields.Length; i++)
                {
                    var field = _winnerFields[i];
                    @if (i > 0)
                    {
                        <span class="winner-field-separator" aria-hidden="true">|</span>
                    }
                    <strong class="winner-field-label">@field.Label</strong>
                    <span class="winner-field-value">@field.Value</span>
                }
            </p>
        }
        @if (_winnerQueuePosition is { } queuePosition)
        {
            <p class="winner-queue-position">Queue position: <strong>#@queuePosition</strong></p>
        }
        <p id="winnerActionPrompt" class="winner-action-prompt">Choose what happens to this queue entry.</p>
        <div class="winner-modal-actions">
            @if (IsNowPlayingWinnerActionEnabled)
            {
                <button id="setWinnerNowPlayingBtn" class="winner-action-button winner-action-primary"
                        disabled="@_winnerActionPending"
                        @onclick="SetWinnerNowPlayingAsync">
                    Set Now Playing
                </button>
            }
            <button id="markWinnerPlayedBtn"
                    class="winner-action-button @(!IsNowPlayingWinnerActionEnabled && _preferMarkWinnerPlayed ? "winner-action-primary" : "winner-action-secondary")"
                    disabled="@_winnerActionPending"
                    @onclick="MarkWinnerPlayedAsync">
                Mark Played
            </button>
            <button id="leaveWinnerInQueueBtn"
                    class="winner-action-button @(!IsNowPlayingWinnerActionEnabled && !_preferMarkWinnerPlayed ? "winner-action-primary" : "winner-action-secondary")"
                    disabled="@_winnerActionPending"
                    @onclick="LeaveWinnerInQueueAsync">
                Leave in Queue
            </button>
        </div>
        @if (_winnerActionPending)
        {
            <p class="winner-action-status" role="status" aria-live="polite">Updating StreamerSongList...</p>
        }
        @if (!string.IsNullOrWhiteSpace(_winnerActionError))
        {
            <p class="winner-action-error" role="alert">@_winnerActionError</p>
        }
    </div>
</dialog>
