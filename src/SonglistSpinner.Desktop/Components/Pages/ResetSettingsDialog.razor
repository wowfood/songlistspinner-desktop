<MudDialog>
    <DialogContent>
        <p class="ss-reset-dialog-intro">
            The following fields in <strong>@ScopeLabel</strong> differ from their shipped defaults and will be reset:
        </p>

        <div class="ss-reset-dialog-fields" aria-label="Settings that will be reset">
            @foreach (var group in Fields.GroupBy(field => field.Section))
            {
                <section>
                    <h4>@group.Key</h4>
                    <ul>
                        @foreach (var field in group)
                        {
                            <li>@field.Label</li>
                        }
                    </ul>
                </section>
            }
        </div>

        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
            This restores shipped defaults, not your last-saved values. It updates the draft only;
            choose <strong>Save Settings</strong> to apply it.
            Your StreamerSongList API credential is not affected.
        </MudAlert>
    </DialogContent>
    <DialogActions>
        <MudButton ButtonType="ButtonType.Button" OnClick="Cancel">Keep current settings</MudButton>
        <MudButton ButtonType="ButtonType.Button" Color="Color.Warning" Variant="Variant.Filled" OnClick="Reset">
            Reset draft to defaults
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter]
    private IMudDialogInstance MudDialog { get; set; } = null!;

    [Parameter]
    public IReadOnlyList<SettingsResetField> Fields { get; set; } = [];

    [Parameter]
    public string ScopeLabel { get; set; } = "Settings";

    private void Cancel() => MudDialog.Cancel();

    private void Reset() => MudDialog.Close(DialogResult.Ok(true));
}
