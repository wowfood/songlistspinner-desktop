@page "/home"

<div class="ss-home">
    <div class="ss-home-card">
        <h1>SonglistSpinner</h1>
        <p class="ss-home-hint">
            Connect your channel with a StreamerSongList streamer access token, then spin and manage the queue directly from the desktop app.
