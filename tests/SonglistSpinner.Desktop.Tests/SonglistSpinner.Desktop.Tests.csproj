<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Tests the few Desktop types that need no running MAUI app. The Desktop project builds only as a Windows
        MAUI application, which a test project cannot reference, so the source files under test are compiled into
        this project (the Compile items below) against the MAUI Essentials interfaces alone. They are the adapters
        that decide where a real user's settings and API token are kept, which the end-to-end tests never reach
        because they always run on a test profile. The rest of Desktop is covered by the end-to-end tests.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\..\src\SonglistSpinner.Desktop\Services\MauiPreferencesStore.cs" Link="Desktop\Services\MauiPreferencesStore.cs"/>
        <Compile Include="..\..\src\SonglistSpinner.Desktop\Services\MauiSecureStorageStore.cs" Link="Desktop\Services\MauiSecureStorageStore.cs"/>
        <Compile Include="..\..\src\SonglistSpinner.Desktop\Services\IsolatedProfileServiceCollectionExtensions.cs" Link="Desktop\Services\IsolatedProfileServiceCollectionExtensions.cs"/>
        <Compile Include="..\..\src\SonglistSpinner.Desktop\Services\LocalSettingsServiceCollectionExtensions.cs" Link="Desktop\Services\LocalSettingsServiceCollectionExtensions.cs"/>
        <Compile Include="..\..\src\SonglistSpinner.Desktop\Services\StreamerSongListServiceCollectionExtensions.cs" Link="Desktop\Services\StreamerSongListServiceCollectionExtensions.cs"/>
        <!-- The Desktop project gets these namespaces from MAUI's implicit usings. -->
        <Using Include="Microsoft.Extensions.DependencyInjection"/>
        <Using Include="Microsoft.Maui.Storage"/>
    </ItemGroup>
    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.11"/>
        <!-- AddHttpClient, which the StreamerSongList registration uses; the Desktop project references it too. -->
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11"/>
        <!-- The interfaces the adapters implement; keep in step with MauiVersion in the Desktop project. -->
        <PackageReference Include="Microsoft.Maui.Essentials" Version="10.0.90"/>
        <!-- Coverage as a diagnostic; the command is in AGENTS.md. -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2"/>
        <PackageReference Include="xunit.v3" Version="4.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SonglistSpinner.Application\SonglistSpinner.Application.csproj"/>
    </ItemGroup>
</Project>
