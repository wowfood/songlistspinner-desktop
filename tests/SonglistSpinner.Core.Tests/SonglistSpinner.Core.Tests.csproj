<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Saved settings JSON, named for the version that wrote it; the logical name survives folder moves. -->
        <EmbeddedResource Include="**/Fixtures/*.json" LogicalName="Fixtures.%(Filename)%(Extension)"/>
    </ItemGroup>
    <ItemGroup>
        <!-- Coverage as a diagnostic; the command is in AGENTS.md. -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2"/>
        <PackageReference Include="xunit.v3" Version="4.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SonglistSpinner.Core\SonglistSpinner.Core.csproj"/>
        <ProjectReference Include="..\SonglistSpinner.Testing\SonglistSpinner.Testing.csproj"/>
    </ItemGroup>
</Project>
