<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
    </ItemGroup>
    <ItemGroup>
        <!-- FakeLogger; it also brings the DI container the registration test builds. -->
        <PackageReference Include="Microsoft.Extensions.Diagnostics.Testing" Version="10.10.0"/>
        <!-- Coverage as a diagnostic; the command is in AGENTS.md. -->
        <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" Version="18.11.2"/>
        <PackageReference Include="xunit.v3" Version="4.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\..\src\SonglistSpinner.Application\SonglistSpinner.Application.csproj"/>
        <ProjectReference Include="..\SonglistSpinner.Testing\SonglistSpinner.Testing.csproj"/>
    </ItemGroup>
</Project>
