<Project Sdk="Microsoft.NET.Sdk">
    <!--
        Opt-in end-to-end tests: each test class starts the built Desktop app (a real window) against the in-process
        StreamerSongList simulator and drives its WebView through the DevTools protocol with Playwright; its tests
        share that app, which is reset between them (see SharedApp). They skip unless SONGLISTSPINNER_E2E=1;
        scripts/run-e2e.ps1 builds the app and runs them. The app runs on a temporary test profile, a free overlay
        port and a local update URL, so it never touches the user's settings, credential, logs or running app, the
        real StreamerSongList service or GitHub.
        The project does not reference the Desktop app: it tests the built executable as a user would run it.
    -->
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
    </PropertyGroup>
    <ItemGroup>
        <AssemblyAttribute Include="System.Diagnostics.CodeAnalysis.ExcludeFromCodeCoverage"/>
    </ItemGroup>
    <ItemGroup>
        <!--
            The app's WebView is reached with ConnectOverCDPAsync and the overlay is opened in the system's Microsoft
            Edge (the msedge channel), so no Playwright browser download is needed.
        -->
        <PackageReference Include="Microsoft.Playwright" Version="1.54.0"/>
        <PackageReference Include="xunit.v3" Version="4.0.0"/>
    </ItemGroup>
    <ItemGroup>
        <!-- One app window at a time: test classes run one after another, each with its own app and simulator. -->
        <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\SonglistSpinner.StreamerSongListSimulator\SonglistSpinner.StreamerSongListSimulator.csproj"/>
    </ItemGroup>
</Project>
